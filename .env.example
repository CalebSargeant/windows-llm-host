# API proxy listens on LAN by default. Keep LLM_HOST_API_KEY set.
API_BIND=0.0.0.0
API_PORT=11434
WEBUI_BIND=127.0.0.1
WEBUI_PORT=3000

# PowerShell scripts generate this for you. Set it before manual docker compose usage.
LLM_HOST_API_KEY=

# Hardware detection updates these during setup. Defaults favor max local capability.
DEFAULT_MODEL=qwen3-coder:30b
RECOMMENDED_FAST_MODEL=qwen3:4b-instruct
RECOMMENDED_BALANCED_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
RECOMMENDED_MAX_MODEL=qwen3-coder:30b
OLLAMA_KEEP_ALIVE=-1
OLLAMA_LOAD_TIMEOUT=30m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=2

# Proxy settings.
ALLOWED_ORIGINS=*
REQUEST_TIMEOUT_MS=0
LOG_REQUESTS=true

# Open WebUI stays unauthenticated while localhost-only. Enable these for LAN exposure.
WEBUI_AUTH=false
ENABLE_API_KEYS=false
USER_PERMISSIONS_FEATURES_API_KEYS=false
