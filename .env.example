# API proxy listens on LAN by default. Keep LLM_HOST_API_KEY set.
API_BIND=0.0.0.0
API_PORT=11434
WEBUI_BIND=127.0.0.1
WEBUI_PORT=3000

# PowerShell scripts generate this for you. Set it before manual docker compose usage.
LLM_HOST_API_KEY=

# Existing laptop-tuned defaults.
DEFAULT_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE=30m
OLLAMA_LOAD_TIMEOUT=30m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# Proxy settings.
ALLOWED_ORIGINS=*
REQUEST_TIMEOUT_MS=0
LOG_REQUESTS=true

# Open WebUI stays unauthenticated while localhost-only. Enable these for LAN exposure.
WEBUI_AUTH=false
ENABLE_API_KEYS=false
USER_PERMISSIONS_FEATURES_API_KEYS=false

# Game Mode watcher (scripts/game-mode-watcher.ps1). Opt-in: pauses the stack while a
# full-screen game is running so it stops competing for GPU/CPU/RAM/thermals.
# GAME_MODE_ACTION: stop (keep containers, fast resume) or down (remove containers, keep models).
GAME_MODE_ACTION=stop
GAME_MODE_RESTORE=true
GAME_MODE_USE_FULLSCREEN=true
# Comma-separated extra process names (no .exe) to always treat as a game, e.g. steam,EscapeFromTarkov
GAME_MODE_PROCESSES=
GAME_MODE_POLL_SECONDS=15
GAME_MODE_COOLDOWN_SECONDS=60
