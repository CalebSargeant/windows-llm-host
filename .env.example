# Keep localhost for safest first run. scripts/start.ps1 -Lan overrides API_BIND to 0.0.0.0.
API_BIND=127.0.0.1
API_PORT=11434
WEBUI_BIND=127.0.0.1
WEBUI_PORT=3000

# Leave blank for no API proxy auth. scripts/bootstrap.ps1 generates one for you.
LLM_HOST_API_KEY=

# Existing laptop-tuned defaults.
DEFAULT_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE=30m
OLLAMA_LOAD_TIMEOUT=30m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# Proxy settings.
ALLOWED_ORIGINS=*
REQUEST_TIMEOUT_MS=0
LOG_REQUESTS=true

# Open WebUI stays unauthenticated while localhost-only. Enable these for LAN exposure.
WEBUI_AUTH=false
ENABLE_API_KEYS=false
USER_PERMISSIONS_FEATURES_API_KEYS=false
