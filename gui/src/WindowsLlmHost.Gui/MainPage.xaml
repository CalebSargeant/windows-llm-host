<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindowsLlmHost.Gui.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WindowsLlmHost.Gui.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16,20,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="windows-llm-host" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.RepoStatus, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="Choose folder" Command="{x:Bind ViewModel.PickRepoCommand}" />
                <Button Content="Refresh all" Command="{x:Bind ViewModel.RefreshAllCommand}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolean}}" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="20,8,20,8" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

                <!-- Stack control -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12"
                                     Fill="{x:Bind ViewModel.StackRunning, Mode=OneWay, Converter={StaticResource BoolToStatusBrush}}" />
                            <TextBlock Text="Stack" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Start" Command="{x:Bind ViewModel.StartStackCommand}" Style="{ThemeResource AccentButtonStyle}" />
                            <Button Content="Stop" Command="{x:Bind ViewModel.StopStackCommand}" />
                            <Button Content="Restart" Command="{x:Bind ViewModel.RestartStackCommand}" />
                            <Button Content="Down (remove containers)" Command="{x:Bind ViewModel.DownStackCommand}" />
                            <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshStatusCommand}" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.Services, Mode=OneWay}"
                                  SelectionMode="None" MaxHeight="220">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ServiceStatus">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Service}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind StateDisplay}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Status}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Connection -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Connection" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="API base URL" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind ViewModel.ApiBaseUrl, Mode=OneWay}" IsReadOnly="True" Width="420" />
                            <Button Content="Copy" Command="{x:Bind ViewModel.CopyBaseUrlCommand}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.LanApiUrl, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="API key (LLM_HOST_API_KEY)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind ViewModel.ApiKey, Mode=OneWay}" IsReadOnly="True" Width="420"
                                     FontFamily="Consolas" />
                            <Button Content="Copy" Command="{x:Bind ViewModel.CopyApiKeyCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{x:Bind ViewModel.LanEnabled, Mode=OneWay}" />
                            <TextBlock VerticalAlignment="Center" Text="= LAN enabled" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="Toggle LAN / local-only" Command="{x:Bind ViewModel.ToggleLanCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Text="Firewall rule:" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.FirewallOk, Mode=OneWay}" FontWeight="SemiBold" />
                            <Button Content="Add firewall rule" Command="{x:Bind ViewModel.AllowFirewallCommand}" />
                        </StackPanel>
                        <TextBlock Text="Open WebUI:" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.WebUiUrl, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Models -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Models" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ListView ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}" MaxHeight="240">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:OllamaModel">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Details}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox PlaceholderText="model name, e.g. qwen3:4b-instruct" Width="360"
                                     Text="{x:Bind ViewModel.NewModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Pull" Command="{x:Bind ViewModel.PullModelCommand}" Style="{ThemeResource AccentButtonStyle}" />
                            <Button Content="Remove selected" Command="{x:Bind ViewModel.RemoveModelCommand}" />
                            <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshModelsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Logs -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Logs" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{x:Bind ViewModel.LogServices}"
                                      SelectedItem="{x:Bind ViewModel.SelectedLogService, Mode=TwoWay}" Width="200" />
                            <Button Content="Load last 200 lines" Command="{x:Bind ViewModel.RefreshLogsCommand}" />
                        </StackPanel>
                        <TextBox Text="{x:Bind ViewModel.LogText, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                 Height="220" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Updates" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{x:Bind ViewModel.UpdateChannels}"
                                      SelectedItem="{x:Bind ViewModel.UpdateChannel, Mode=TwoWay}" Width="160" />
                            <Button Content="Check" Command="{x:Bind ViewModel.CheckUpdateCommand}" />
                            <Button Content="Apply update" Command="{x:Bind ViewModel.ApplyUpdateCommand}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.VersionSummary, Mode=OneWay}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.UpdateDetail, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Game Mode -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Game Mode" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Pause the stack while a full-screen game is running."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Status" Command="{x:Bind ViewModel.RefreshGameModeCommand}" />
                            <Button Content="Install watcher" Command="{x:Bind ViewModel.InstallGameModeCommand}" />
                            <Button Content="Remove watcher" Command="{x:Bind ViewModel.UninstallGameModeCommand}" />
                        </StackPanel>
                        <TextBox Text="{x:Bind ViewModel.GameModeStatus, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                 Height="140" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!-- Open WebUI exposure -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Open WebUI exposure" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ToggleSwitch Header="Expose Open WebUI on the LAN (WEBUI_BIND=0.0.0.0)"
                                      IsOn="{x:Bind ViewModel.WebUiExposed, Mode=TwoWay}" />
                        <ToggleSwitch Header="Require auth + API keys (recommended when exposed)"
                                      IsOn="{x:Bind ViewModel.WebUiAuth, Mode=TwoWay}" />
                        <Button Content="Apply Open WebUI settings" Command="{x:Bind ViewModel.SaveWebUiSettingsCommand}" />
                        <TextBlock Text="Applying recreates the containers (docker compose up -d)."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Busy overlay -->
        <Border Grid.Row="1" Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="48" Height="48" />
                <TextBlock Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Footer status bar -->
        <Border Grid.Row="2" Padding="20,8" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{x:Bind ViewModel.LastMessage, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Page>
